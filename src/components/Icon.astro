---
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'chevron' | 'arrow-left';
}
const paths = {
  'arrow-right': ['M5 12h14', 'M13 6l6 6-6 6'],
  'arrow-up-right': ['M7 17L17 7', 'M8 7h9v9'],
  chevron: ['M9 6l6 6-6 6'],
  'arrow-left': ['M19 12H5', 'M11 6l-6 6 6 6'],
};
const { name } = Astro.props;
---

<svg
  class="icon"
  aria-hidden="true"
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
